# Browser-safe Supabase configuration. Values are safe placeholders for local builds.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key

# Server-only key for owner-profile authorization. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key

# Server-only direct PostgreSQL connection used by Drizzle commands and server code.
# Use the Supabase pooler URL for deployed serverless environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/azzam_mitra

